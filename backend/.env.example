SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Correos transaccionales (Fase 6) — Resend, permiso "Sending access" alcanza.
# Sin dominio verificado en Resend, los correos de prueba solo llegan a la
# casilla de la cuenta de Resend, no a destinatarios reales — ver readme_guia.md.
RESEND_API_KEY=re_your-api-key-here
